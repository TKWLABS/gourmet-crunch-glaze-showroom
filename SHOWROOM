<script>(()=>{const key='gourmetSoupLabFeedbackV1';let answer='';const $=id=>document.getElementById(id);const list=()=>{try{return JSON.parse(localStorage.getItem(key)||'[]')}catch{return[]}};const say=s=>{const e=$('status');e.textContent=s;e.classList.add('show');setTimeout(()=>e.classList.remove('show'),3000)};document.querySelectorAll('[data-answer]').forEach(b=>b.onclick=()=>{answer=b.dataset.answer;document.querySelectorAll('[data-answer]').forEach(x=>x.classList.toggle('sel',x===b));$('follow').classList.add('show');$('yesfields').hidden=answer!=='yes';$('nofields').hidden=answer!=='no';$('followtitle').textContent=answer==='yes'?'What caught your eye?':'Why not?';$('follow').scrollIntoView({behavior:'smooth',block:'nearest'})});$('othercheck').onchange=e=>$('other').classList.toggle('show',e.target.checked);$('submit').onclick=()=>{if(!answer)return say('Please choose Yes or No first.');const r={response:answer,product:answer==='yes'?$('product').value:'',price:answer==='yes'?$('price').value:'',reasons:answer==='no'?[...document.querySelectorAll('#reasons input:checked')].map(x=>x.value):[],other:answer==='no'&&$('othercheck').checked?$('othertext').value.trim():'',submittedAt:new Date().toISOString()};try{localStorage.setItem(key,JSON.stringify([...list(),r]))}catch{return say('This browser could not save the response.')}$('question').hidden=true;$('thanks').classList.add('show')};$('again').onclick=()=>{answer='';$('question').hidden=false;$('thanks').classList.remove('show');$('follow').classList.remove('show');document.querySelectorAll('[data-answer]').forEach(x=>x.classList.remove('sel'));document.querySelectorAll('#reasons input').forEach(x=>x.checked=false);$('other').classList.remove('show');$('othertext').value='';$('product').selectedIndex=0;$('price').selectedIndex=0};$('export').onclick=()=>{const data=list();if(!data.length)return say('No feedback has been saved in this browser yet.');const cols=['response','product','price','reasons','other','submittedAt'];const quote=v=>'"'+String(v??'').replaceAll('"','""')+'"';const csv=[cols.join(','),...data.map(r=>cols.map(c=>quote(Array.isArray(r[c])?r[c].join('; '):r[c])).join(','))].join('\r\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download='gourmet-crunch-glaze-feedback.csv';a.click();URL.revokeObjectURL(a.href);say('Feedback file downloaded.')};})();</script></body></html>







